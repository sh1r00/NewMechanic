{
  "name": "mechanic-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "theme": {
    "primary": "#d97706",
    "secondary": "#5d4037",
    "tertiary": "#4a6741"
  },
  "scripts": {
    "dev": "node scripts/generate-theme.mjs && nuxi dev",
    "build": "node scripts/generate-theme.mjs && nuxi build",
    "generate": "node scripts/generate-theme.mjs && nuxi generate",
    "generate:theme": "node scripts/generate-theme.mjs",
    "preview": "nuxi preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "nuxi prepare"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "nuxt": "^4.4.7",
    "pinia": "^3.0.4",
    "satori": "^0.26.0",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/seo": "^5.1.3",
    "@tailwindcss/vite": "^4.0.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vue/test-utils": "^2.4.10",
    "nuxt-security": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "glob": "^11.0.0"
  }
